# Copy to .env and edit. The server reads real environment variables and does not load this file itself:
#   set -a; . ./.env; set +a
# Defaults live in apps/api/src/config.ts. Never commit real credentials.

PORT=3001
HOST=0.0.0.0

# PostgreSQL (Neon in production). Tables are created and upgraded automatically on startup.
DATABASE_URL=postgresql://postgres:localtest@localhost:5432/studio_local_test

# Cloudflare R2: keeps uploaded videos while a job is unfinished and serves the finished clips.
# All four must be set to enable it. Without them the server runs in a clearly labelled local-only mode.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# true = refuse to start unless all four R2 settings are present (recommended in production).
REQUIRE_DURABLE_STORAGE=false

# Jobs: how many may be in the CPU-heavy stages at once, how often a job may be started in total,
# and the heartbeat/staleness window used to notice jobs abandoned by a dead process.
JOB_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_STALE_AFTER_SECONDS=60
JOB_HEARTBEAT_SECONDS=15

# On Render (which sets RENDER_EXTERNAL_URL by itself) the server requests its own /api/health every 4 minutes
# while a job is being processed or an upload is arriving, so a free instance is not spun down mid-job.
# false = never do that. Has no effect when RENDER_EXTERNAL_URL is not set (local development).
KEEP_AWAKE_WHILE_PROCESSING=true

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=2147483648
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TEMP_DIR=./tmp
OUTPUT_DIR=./outputs

CLIP_MAX_CANDIDATES=3
CLIP_VERTICAL_WIDTH=1080
CLIP_VERTICAL_HEIGHT=1920
CLIP_VIDEO_CODEC=libx264
CLIP_AUDIO_CODEC=aac
CLIP_CRF=23
CLIP_PRESET=veryfast
# true = the upload page offers "Follow a face (beta)", which moves the 9:16 window to keep a face in view (costs extra CPU time per clip).
# false = never offered, every clip is cut from the middle. A person still has to choose it for each video.
FACE_FRAMING_ENABLED=true
# true = once the server is listening and idle, check that FFmpeg, the caption font and whisper.cpp really work on this machine (a few tiny
# clips, a couple of seconds on a normal machine). The details go to the log; /api/health shows only whether it passed and which checks failed.
TOOLCHAIN_CHECK_ENABLED=true

TRANSCRIPTION_ENGINE=whisper_cpp
# `npm run setup:whisper` builds these two files into .render/ at the repository root.
WHISPER_CPP_PATH=../../.render/whisper-cli
WHISPER_MODEL_PATH=../../.render/ggml-base.en.bin
TRANSCRIPTION_LANGUAGE=en
TRANSCRIPTION_TIMEOUT_MS=3600000
# Optional: a hosted service that speaks the OpenAI audio/transcriptions protocol, instead of whisper.cpp on this machine.
# The audio of each video is sent to that service. Put the key in the host's environment settings, never in the repository.
# TRANSCRIPTION_ENGINE=openai_compatible
# TRANSCRIPTION_API_URL=https://api.example.com/v1
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_API_MODEL=whisper-1
# TRANSCRIPTION_CHUNK_SECONDS=600
# TRANSCRIPTION_API_CONCURRENCY=3
# TRANSCRIPTION_API_TIMEOUT_MS=300000

HIGHLIGHT_MIN_DURATION_SECONDS=20
HIGHLIGHT_MAX_DURATION_SECONDS=60
HIGHLIGHT_MAX_CANDIDATES=5
HIGHLIGHT_OVERLAP_THRESHOLD=0.3
HIGHLIGHT_WEIGHT_DENSITY=0.25
HIGHLIGHT_WEIGHT_EMPHASIS=0.20
HIGHLIGHT_WEIGHT_QUESTION=0.10
HIGHLIGHT_WEIGHT_NUMBER=0.10
HIGHLIGHT_WEIGHT_CONTRAST=0.15
HIGHLIGHT_WEIGHT_HOOK=0.10
HIGHLIGHT_WEIGHT_COMPLETENESS=0.10
HIGHLIGHT_WEIGHT_STANDALONE=0.10
HIGHLIGHT_WEIGHT_CONTINUITY=0.10
HIGHLIGHT_WEIGHT_LENGTH=0.10

CORS_ORIGIN=http://localhost:5173

# Optional shared access code (at least 8 characters). When set, every page and API route except /api/health asks for it:
# people type it once on /login, programs send "Authorization: Bearer <code>". Leave it unset for a private test.
# Put the real value in the host's environment settings, never in the repository.
# ACCESS_CODE=

# Optional YouTube ingestion through a separately hosted Cobalt instance.
# COBALT_API_URL=
# COBALT_API_KEY=
# YOUTUBE_DOWNLOAD_TIMEOUT_MS=1200000
